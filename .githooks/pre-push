#!/bin/sh
# Pre-push hook: run the full test suite and block the push if it fails.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# The tests run against the working tree, which matches the pushed commits
# only when there are no uncommitted changes.

echo "pre-push: running the test suite (uv run pytest -q)"
uv run pytest -q
status=$?
if [ "$status" -ne 0 ]; then
    echo "pre-push: tests failed (exit $status); push blocked." >&2
    exit 1
fi
echo "pre-push: tests passed."
